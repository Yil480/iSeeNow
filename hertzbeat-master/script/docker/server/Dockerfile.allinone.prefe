# ============================================================================
# 【临时构建定义】irespsee:allinone —— 前端产物由宿主机预构建
# ----------------------------------------------------------------------------
# 用途：绕开原 Dockerfile.allinone 的 Stage 1（容器内 pnpm run build）。
#       该阶段要求 Node 堆 8GB，而本机 Docker Desktop(WSL2) 仅分得 8GB，
#       构建时会把 Docker 挤崩（buildkit rpc EOF），并通过 restart 策略
#       连带重启全部业务容器。
# 用法：前端先在宿主机执行 `cd web-app && npm run build`，
#       将 web-app/dist 复制到 script/docker/server/fe-dist，
#       再执行：
#         docker build -t irespsee:allinone -f script/docker/server/Dockerfile.allinone.prefe .
# 说明：除 Stage 1 被本地产物替代外，Stage 2/3 与 Dockerfile.allinone 完全一致。
# ============================================================================

# ----------------------------------------------------------------------------
# Stage 2: 构建后端 Spring Boot 胖 JAR
# ----------------------------------------------------------------------------
FROM maven:3.9.11-eclipse-temurin-25 AS backend
WORKDIR /build

COPY pom.xml ./
COPY hertzbeat-base ./hertzbeat-base
COPY hertzbeat-common-core ./hertzbeat-common-core
COPY hertzbeat-common-spring ./hertzbeat-common-spring
COPY hertzbeat-collector ./hertzbeat-collector
COPY hertzbeat-manager ./hertzbeat-manager
COPY hertzbeat-warehouse ./hertzbeat-warehouse
COPY hertzbeat-alerter ./hertzbeat-alerter
COPY hertzbeat-remoting ./hertzbeat-remoting
COPY hertzbeat-push ./hertzbeat-push
COPY hertzbeat-plugin ./hertzbeat-plugin
COPY hertzbeat-grafana ./hertzbeat-grafana
COPY hertzbeat-otel ./hertzbeat-otel
COPY hertzbeat-e2e ./hertzbeat-e2e
COPY hertzbeat-observability ./hertzbeat-observability
COPY hertzbeat-ai ./hertzbeat-ai
COPY hertzbeat-startup ./hertzbeat-startup

# 关键：把宿主机预构建的前端产物放入 manager 模块 classpath 的 /dist 目录，
# 与 application.yml 中 static-locations: classpath:/dist/ 对应
COPY script/docker/server/fe-dist ./hertzbeat-manager/src/main/resources/dist

# 使用阿里云镜像源加速依赖下载（仅改变下载来源，不改变依赖坐标）
COPY script/docker/server/maven-settings.xml /root/.m2/settings.xml

# Maven 打包：JDK 25 由基础镜像满足；跳过测试与代码风格检查
RUN mvn -B clean package -DskipTests -Dcheckstyle.skip=true \
    -Dmaven.resolver.transport=wagon \
    -Dmaven.wagon.http.ssl.insecure=true \
    -Dmaven.wagon.http.ssl.allowall=true \
    -Dmaven.wagon.http.ssl.ignore.validity.dates=true

# ----------------------------------------------------------------------------
# Stage 3: 运行时镜像（JDK + 应用 JAR）
# ----------------------------------------------------------------------------
FROM eclipse-temurin:25-jdk AS runtime

ENV TZ=Asia/Shanghai
ENV LANG=en_US.UTF-8
ENV JAVA_OPTS="-Xms512m -Xmx1024m -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8 -Doracle.jdbc.timezoneAsRegion=false --add-opens=java.base/java.nio=org.apache.arrow.memory.core,ALL-UNNAMED"

WORKDIR /opt/hertzbeat

COPY --from=backend /build/hertzbeat-startup/target/apache-hertzbeat-1.9.0.jar /opt/hertzbeat/hertzbeat.jar

RUN mkdir -p /opt/hertzbeat/data
VOLUME ["/opt/hertzbeat/data"]

EXPOSE 1157 1158 14317

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /opt/hertzbeat/hertzbeat.jar"]
